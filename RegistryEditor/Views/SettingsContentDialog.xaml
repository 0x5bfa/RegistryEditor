<ContentDialog
	x:Class="RegistryEditor.Views.SettingsContentDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:CommunityToolkit.WinUI.Controls"
	CloseButtonText="Close"
	Style="{StaticResource DefaultContentDialogStyle}">

	<ContentDialog.Resources>
		<x:Double x:Key="ContentDialogMinWidth">560</x:Double>
		<x:Double x:Key="ContentDialogMaxWidth">560</x:Double>
		<x:Double x:Key="ContentDialogMinHeight">640</x:Double>
		<x:Double x:Key="ContentDialogMaxHeight">640</x:Double>
	</ContentDialog.Resources>

	<ScrollViewer>
		<StackPanel Spacing="12">
			<controls:SettingsExpander
				Description="Customize how Registry Editor looks."
				Header="Appearance"
				IsExpanded="True">
				<controls:SettingsExpander.Items>
					<controls:SettingsCard Description="Choose the theme used by the application." Header="Theme">
						<ComboBox
							Width="150"
							AutomationProperties.AutomationId="ThemeSettingsComboBox"
							ItemsSource="{x:Bind ViewModel.ThemeOptions}"
							SelectedIndex="{x:Bind ViewModel.SelectedThemeIndex, Mode=TwoWay}" />
					</controls:SettingsCard>
				</controls:SettingsExpander.Items>
			</controls:SettingsExpander>

			<controls:SettingsExpander
				Description="Customize navigation and value display."
				Header="Preferences"
				IsExpanded="True">
				<controls:SettingsExpander.Items>
					<controls:SettingsCard Description="Show the registry path address bar above the tree and value list." Header="Address bar">
						<ToggleSwitch
							x:Name="AddressBarSettingsToggle"
							AutomationProperties.AutomationId="AddressBarSettingsToggle"
							IsOn="{x:Bind ViewModel.IsAddressBarVisible, Mode=OneWay}"
							Toggled="AddressBarSettingsToggle_Toggled" />
					</controls:SettingsCard>
				</controls:SettingsExpander.Items>
			</controls:SettingsExpander>

			<controls:SettingsExpander
				Description="Information about this application."
				Header="Application"
				IsExpanded="False">
				<controls:SettingsExpander.Items>
					<controls:SettingsCard Description="A WinUI 3 registry browser." Header="Registry Editor">
						<TextBlock VerticalAlignment="Center" Text="Registry Editor" />
					</controls:SettingsCard>
				</controls:SettingsExpander.Items>
			</controls:SettingsExpander>
		</StackPanel>
	</ScrollViewer>
</ContentDialog>
