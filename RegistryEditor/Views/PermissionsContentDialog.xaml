<ContentDialog
	x:Class="RegistryEditor.Views.PermissionsContentDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:viewModels="using:RegistryEditor.ViewModels"
	CloseButtonText="Cancel"
	PrimaryButtonText="Save"
	Style="{StaticResource DefaultContentDialogStyle}">
	<ScrollViewer MaxHeight="520">
		<StackPanel MinWidth="480" Spacing="8">
			<TextBlock x:Name="KeyPathTextBlock" TextWrapping="Wrap" />
			<TextBlock Text="Current rules" />
			<ListView
				x:Name="RulesListView"
				MaxHeight="220"
				IsItemClickEnabled="False"
				SelectionMode="None">
				<ListView.ItemTemplate>
					<DataTemplate x:DataType="viewModels:RegistryPermissionRuleViewModel">
						<TextBlock Text="{x:Bind Text}" TextWrapping="Wrap" />
					</DataTemplate>
				</ListView.ItemTemplate>
			</ListView>
			<TextBlock Text="Add a rule" />
			<TextBox x:Name="AccountTextBox" PlaceholderText="Account (for example, DOMAIN\User)" />
			<ComboBox x:Name="RightsComboBox" Header="Permission level">
				<ComboBox.ItemTemplate>
					<DataTemplate x:DataType="viewModels:RegistryPermissionChoice">
						<TextBlock Text="{x:Bind Name}" />
					</DataTemplate>
				</ComboBox.ItemTemplate>
			</ComboBox>
			<ComboBox x:Name="AccessTypeComboBox" Header="Access type" />
			<TextBlock
				x:Name="ErrorTextBlock"
				Foreground="Red"
				TextWrapping="Wrap" />
		</StackPanel>
	</ScrollViewer>
</ContentDialog>
