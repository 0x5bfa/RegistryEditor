<UserControl
	x:Class="RegistryEditor.Views.RootView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:controls="using:RegistryEditor.Controls"
	xmlns:tv="using:WinUI.TableView"
	xmlns:viewModels="using:RegistryEditor.ViewModels"
	xmlns:wctcontrols="using:CommunityToolkit.WinUI.Controls"
	x:Name="RootViewControl">

	<UserControl.Resources>
		<ResourceDictionary>

			<DataTemplate x:Key="RegistryTreeNodeTemplate" x:DataType="viewModels:RegistryNodeViewModel">
				<TreeViewItem
					ContextRequested="RegistryTreeItem_ContextRequested"
					HasUnrealizedChildren="{x:Bind HasUnrealizedChildren, Mode=OneWay}"
					IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
					ItemsSource="{x:Bind Children, Mode=OneWay}">
					<TreeViewItem.ContextFlyout>
						<MenuFlyout AreOpenCloseAnimationsEnabled="False" Opening="RegistryTreeContextFlyout_Opening">
							<MenuFlyoutItem Tag="Expand" Text="Expand" />
							<MenuFlyoutSubItem AccessKey="N" Text="New">
								<MenuFlyoutItem Tag="NewKey" Text="Key" />
								<MenuFlyoutItem Tag="NewStringValue" Text="String Value" />
								<MenuFlyoutItem Tag="NewBinaryValue" Text="Binary Value" />
								<MenuFlyoutItem Tag="NewDWordValue" Text="DWORD (32-bit) Value" />
								<MenuFlyoutItem Tag="NewQWordValue" Text="QWORD (64-bit) Value" />
								<MenuFlyoutItem Tag="NewMultiStringValue" Text="Multi-String Value" />
								<MenuFlyoutItem Tag="NewExpandableStringValue" Text="Expandable String Value" />
							</MenuFlyoutSubItem>
							<MenuFlyoutItem
								AccessKey="F"
								Tag="Find"
								Text="Find..." />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem
								AccessKey="D"
								Tag="DeleteKey"
								Text="Delete" />
							<MenuFlyoutItem
								AccessKey="R"
								Tag="RenameKey"
								Text="Rename" />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem
								AccessKey="E"
								Tag="Export"
								Text="Export" />
							<MenuFlyoutItem
								AccessKey="P"
								Tag="Permissions"
								Text="Access permissions..." />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem
								AccessKey="C"
								Tag="CopyKey"
								Text="Copy Key Name" />
						</MenuFlyout>
					</TreeViewItem.ContextFlyout>
					<StackPanel
						VerticalAlignment="Center"
						Orientation="Horizontal"
						Spacing="6">
						<Image
							Width="16"
							Height="16"
							Source="{x:Bind Icon, Mode=OneTime}" />
						<TextBlock VerticalAlignment="Center" Text="{x:Bind Name, Mode=OneWay}" />
					</StackPanel>
				</TreeViewItem>
			</DataTemplate>

			<Thickness x:Key="AppBarButtonInnerBorderMargin">0,0,0,0</Thickness>
			<Visibility x:Key="AppBarButtonHasFlyoutChevronVisibility">Collapsed</Visibility>
			<Thickness x:Key="AppBarButtonContentViewboxCollapsedMargin">0,9,0,9</Thickness>
			<x:Double x:Key="AppBarButtonContentHeight">14</x:Double>

			<Style
				x:Key="CompactAppBarButtonStyle"
				BasedOn="{StaticResource DefaultAppBarButtonStyle}"
				TargetType="AppBarButton">
				<Setter Property="Width" Value="32" />
				<Setter Property="Height" Value="32" />
				<Setter Property="Margin" Value="4,4,4,4" />
				<Setter Property="Padding" Value="0,0,0,0" />
				<Setter Property="VerticalAlignment" Value="Center" />
				<Setter Property="LabelPosition" Value="Collapsed" />
				<Setter Property="VerticalContentAlignment" Value="Center" />
				<Setter Property="HorizontalContentAlignment" Value="Center" />
			</Style>

		</ResourceDictionary>

	</UserControl.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
			<RowDefinition Height="*" />
		</Grid.RowDefinitions>

		<TitleBar
			Title="Registry Editor"
			Grid.Row="0"
			Background="{ThemeResource LayerFillColorDefaultBrush}">
			<TitleBar.IconSource>
				<ImageIconSource ImageSource="/Assets/Branding/AppLogo.png" />
			</TitleBar.IconSource>
		</TitleBar>

		<StackPanel
			Grid.Row="1"
			Padding="4,0,0,0"
			Background="{ThemeResource LayerFillColorDefaultBrush}"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			Orientation="Horizontal">

			<AppBarButton
				AutomationProperties.AutomationId="BackButton"
				AutomationProperties.Name="Back"
				Command="{x:Bind ViewModel.BackCommand}"
				Style="{StaticResource CompactAppBarButtonStyle}"
				ToolTipService.ToolTip="Back">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE72B;" />
				</AppBarButton.Icon>
			</AppBarButton>

			<AppBarButton
				AutomationProperties.AutomationId="ForwardButton"
				AutomationProperties.Name="Forward"
				Command="{x:Bind ViewModel.ForwardCommand}"
				Style="{StaticResource CompactAppBarButtonStyle}"
				ToolTipService.ToolTip="Forward">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE72A;" />
				</AppBarButton.Icon>
			</AppBarButton>

			<AppBarButton
				AutomationProperties.AutomationId="RefreshButton"
				AutomationProperties.Name="Refresh"
				Command="{x:Bind ViewModel.RefreshCommand}"
				Style="{StaticResource CompactAppBarButtonStyle}"
				ToolTipService.ToolTip="Refresh">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE72C;" />
				</AppBarButton.Icon>
			</AppBarButton>

			<AppBarSeparator />

			<MenuBar>
				<MenuBarItem Title="File">
					<MenuFlyoutItem
						AccessKey="I"
						Command="{x:Bind ViewModel.ImportCommand}"
						Text="Import..." />
					<MenuFlyoutItem
						AccessKey="E"
						Command="{x:Bind ViewModel.ExportCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Export..." />
					<MenuFlyoutSeparator />
					<MenuFlyoutItem Command="{x:Bind ViewModel.LoadHiveCommand}" Text="Load hive..." />
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.UnloadHiveCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Unload hive..." />
					<MenuFlyoutSeparator />
					<MenuFlyoutItem Command="{x:Bind ViewModel.ConnectRemoteCommand}" Text="Connect to network registry..." />
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.DisconnectRemoteCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Disconnect from network registry" />
					<MenuFlyoutSeparator />
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.PrintCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Print...">
						<MenuFlyoutItem.KeyboardAccelerators>
							<KeyboardAccelerator Key="P" Modifiers="Control" />
						</MenuFlyoutItem.KeyboardAccelerators>
					</MenuFlyoutItem>
					<MenuFlyoutSeparator />
					<MenuFlyoutItem Command="{x:Bind ViewModel.ExitCommand}" Text="Exit" />
				</MenuBarItem>

				<MenuBarItem Title="Edit">
					<MenuFlyoutSubItem Text="New">
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewKeyCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="Key" />
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewStringValueCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="String Value" />
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewBinaryValueCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="Binary Value" />
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewDWordValueCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="DWORD (32-bit) Value" />
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewQWordValueCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="QWORD (64-bit) Value" />
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewMultiStringValueCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="Multi-String Value" />
						<MenuFlyoutItem
							Command="{x:Bind ViewModel.NewExpandableStringValueCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Text="Expandable String Value" />
					</MenuFlyoutSubItem>
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.PermissionsCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Access permissions..." />
					<MenuFlyoutSeparator />
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.DeleteKeyCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Delete" />
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.RenameKeyCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Rename" />
					<MenuFlyoutItem
						Command="{x:Bind ViewModel.CopyKeyCommand}"
						CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
						Text="Copy Key Name" />
					<MenuFlyoutItem Command="{x:Bind ViewModel.FindCommand}" Text="Find..." />
				</MenuBarItem>

				<MenuBarItem Title="View">
					<ToggleMenuFlyoutItem
						Command="{x:Bind ViewModel.ToggleAddressBarCommand}"
						IsChecked="{x:Bind ViewModel.IsAddressBarVisible, Mode=OneWay}"
						Text="Show address bar" />
					<MenuFlyoutSubItem Text="Appearance">
						<RadioMenuFlyoutItem
							Command="{x:Bind ViewModel.SelectThemeCommand}"
							CommandParameter="0"
							GroupName="ApplicationTheme"
							IsChecked="{x:Bind ViewModel.IsSystemThemeSelected, Mode=OneWay}"
							Text="System default" />
						<RadioMenuFlyoutItem
							Command="{x:Bind ViewModel.SelectThemeCommand}"
							CommandParameter="1"
							GroupName="ApplicationTheme"
							IsChecked="{x:Bind ViewModel.IsLightThemeSelected, Mode=OneWay}"
							Text="Light" />
						<RadioMenuFlyoutItem
							Command="{x:Bind ViewModel.SelectThemeCommand}"
							CommandParameter="2"
							GroupName="ApplicationTheme"
							IsChecked="{x:Bind ViewModel.IsDarkThemeSelected, Mode=OneWay}"
							Text="Dark" />
					</MenuFlyoutSubItem>
					<MenuFlyoutItem Command="{x:Bind ViewModel.CustomizeFontCommand}" Text="Customize font" />
				</MenuBarItem>

				<!--  Favorites menu is temporarily disabled.  -->

			</MenuBar>

			<AppBarSeparator />

			<AppBarButton
				AutomationProperties.AutomationId="AboutButton"
				AutomationProperties.Name="About"
				Command="{x:Bind ViewModel.AboutCommand}"
				Style="{StaticResource CompactAppBarButtonStyle}"
				ToolTipService.ToolTip="About">
				<AppBarButton.Icon>
					<FontIcon Glyph="&#xE946;" />
				</AppBarButton.Icon>
			</AppBarButton>
		</StackPanel>

		<Grid
			x:Name="NavigationBarHost"
			Grid.Row="2"
			Padding="12,4,12,10"
			Background="{ThemeResource LayerFillColorDefaultBrush}"
			ColumnSpacing="8"
			Visibility="{x:Bind ViewModel.AddressBarVisibility, Mode=OneWay}">

			<controls:Omnibar
				x:Name="NavigationOmnibar"
				HorizontalAlignment="Stretch"
				AutomationProperties.AutomationId="NavigationOmnibar"
				QuerySubmitted="NavigationOmnibar_QuerySubmitted"
				TextBoxAutomationId="PathTextBox">
				<controls:OmnibarMode
					x:Name="PathOmnibarMode"
					IsDefault="True"
					ModeName="Registry path"
					PlaceholderText="Enter registry path"
					Text="{x:Bind ViewModel.BreadcrumbPathText, Mode=OneWay}">
					<controls:OmnibarMode.IconOnActive>
						<FontIcon FontSize="16" Glyph="&#xE8B7;" />
					</controls:OmnibarMode.IconOnActive>
					<controls:OmnibarMode.ContentOnInactive>
						<controls:BreadcrumbBar
							x:Name="PathBreadcrumbBar"
							EllipsisButtonToolTip="Show hidden path items"
							ItemClicked="PathBreadcrumbBar_ItemClicked"
							ItemDropDownFlyoutOpening="PathBreadcrumbBar_ItemDropDownFlyoutOpening"
							ItemsSource="{x:Bind ViewModel.BreadcrumbItems, Mode=OneWay}"
							RootItemChevronToolTip="Show child keys"
							RootItemToolTip="Computer">
							<controls:BreadcrumbBar.RootItem>
								<Image
									Width="16"
									Height="16"
									Source="ms-appx:///Assets/Images/Computer.png" />
							</controls:BreadcrumbBar.RootItem>
							<controls:BreadcrumbBar.ItemTemplate>
								<DataTemplate x:DataType="viewModels:RegistryBreadcrumbItemViewModel">
									<controls:BreadcrumbBarItem
										AutomationProperties.Name="{x:Bind Text, Mode=OneTime}"
										ChevronToolTip="{x:Bind Text, Mode=OneTime}"
										Content="{x:Bind Text, Mode=OneTime}"
										IsChevronVisible="{x:Bind IsChevronVisible, Mode=OneTime}"
										ItemToolTip="{x:Bind Text, Mode=OneTime}" />
								</DataTemplate>
							</controls:BreadcrumbBar.ItemTemplate>
						</controls:BreadcrumbBar>
					</controls:OmnibarMode.ContentOnInactive>
				</controls:OmnibarMode>
			</controls:Omnibar>

		</Grid>

		<ProgressBar
			Grid.Row="3"
			Height="2"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Top"
			IsIndeterminate="True"
			Visibility="{x:Bind ViewModel.LoadingVisibility, Mode=OneWay}" />

		<Grid
			Grid.Row="3"
			BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
			BorderThickness="0,1,0,0">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="320" MinWidth="180" />
				<ColumnDefinition Width="1" />
				<ColumnDefinition Width="*" MinWidth="240" />
				<ColumnDefinition Width="1" />
				<ColumnDefinition Width="360" MinWidth="320" />
			</Grid.ColumnDefinitions>

			<TreeView
				x:Name="RegistryTreeView"
				Grid.Column="0"
				Expanding="RegistryTreeView_Expanding"
				ItemTemplate="{StaticResource RegistryTreeNodeTemplate}"
				ItemsSource="{x:Bind ViewModel.RootNodes, Mode=OneWay}"
				SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
				SelectionChanged="RegistryTreeView_SelectionChanged"
				SelectionMode="Single" />

			<wctcontrols:GridSplitter
				Grid.Column="1"
				MinWidth="1"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Background="{ThemeResource DividerStrokeColorDefaultBrush}"
				Foreground="Transparent"
				IsTabStop="False"
				ResizeBehavior="PreviousAndNext"
				ResizeDirection="Columns" />

			<Grid Grid.Column="2" Background="{ThemeResource LayerFillColorDefaultBrush}">
				<tv:TableView
					x:Name="RegistryValueTableView"
					AutoGenerateColumns="False"
					BorderThickness="0"
					CanFilterColumns="False"
					CanReorderColumns="False"
					CanResizeColumns="True"
					CornerButtonMode="None"
					CornerRadius="0"
					GridLinesVisibility="None"
					HeaderRowHeight="32"
					IsReadOnly="True"
					IsTabStop="True"
					ItemsSource="{x:Bind ViewModel.RegistryValues, Mode=OneWay}"
					RowContextFlyoutOpening="RegistryValueTableView_RowContextFlyoutOpening"
					RowMinHeight="32"
					SelectedItem="{x:Bind ViewModel.SelectedValue, Mode=OneWay}"
					SelectionChanged="RegistryValueTableView_SelectionChanged"
					SelectionMode="Single"
					SelectionUnit="Row">
					<tv:TableView.RowContextFlyout>
						<MenuFlyout AreOpenCloseAnimationsEnabled="False">
							<MenuFlyoutItem
								AccessKey="M"
								Click="RegistryValueTableView_EditInPaneClicked"
								Tag="Modify"
								Text="Edit in pane" />
							<MenuFlyoutSeparator />
							<MenuFlyoutItem
								AccessKey="D"
								Tag="Delete"
								Text="Delete" />
							<MenuFlyoutItem
								AccessKey="R"
								Tag="Rename"
								Text="Rename" />
						</MenuFlyout>
					</tv:TableView.RowContextFlyout>
					<tv:TableView.Columns>
						<tv:TableViewTemplateColumn
							Width="220"
							MinWidth="120"
							Header="Name">
							<tv:TableViewTemplateColumn.CellTemplate>
								<DataTemplate x:DataType="viewModels:RegistryValueViewModel">
									<StackPanel
										Margin="10,0"
										VerticalAlignment="Center"
										Orientation="Horizontal"
										Spacing="8">
										<Viewbox>
											<Image
												Width="16"
												Height="16"
												Source="{x:Bind Icon, Mode=OneTime}" />
										</Viewbox>
										<TextBlock Text="{x:Bind Name, Mode=OneTime}" TextTrimming="CharacterEllipsis" />
									</StackPanel>
								</DataTemplate>
							</tv:TableViewTemplateColumn.CellTemplate>
						</tv:TableViewTemplateColumn>

						<tv:TableViewTemplateColumn
							Width="150"
							MinWidth="80"
							Header="Type">
							<tv:TableViewTemplateColumn.CellTemplate>
								<DataTemplate x:DataType="viewModels:RegistryValueViewModel">
									<TextBlock
										Margin="10,0"
										Text="{x:Bind Type, Mode=OneTime}"
										TextTrimming="CharacterEllipsis" />
								</DataTemplate>
							</tv:TableViewTemplateColumn.CellTemplate>
						</tv:TableViewTemplateColumn>

						<tv:TableViewTemplateColumn
							Width="*"
							MinWidth="120"
							Header="Data">
							<tv:TableViewTemplateColumn.CellTemplate>
								<DataTemplate x:DataType="viewModels:RegistryValueViewModel">
									<TextBlock
										Margin="10,0"
										FontFamily="{x:Bind DataFontFamily, Mode=OneWay}"
										Text="{x:Bind Data, Mode=OneTime}"
										TextTrimming="CharacterEllipsis" />
								</DataTemplate>
							</tv:TableViewTemplateColumn.CellTemplate>
						</tv:TableViewTemplateColumn>
					</tv:TableView.Columns>
				</tv:TableView>

				<TextBlock
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					IsHitTestVisible="False"
					Text="{x:Bind ViewModel.ValuesEmptyText, Mode=OneWay}"
					Visibility="{x:Bind ViewModel.ValuesEmptyVisibility, Mode=OneWay}" />
			</Grid>

			<wctcontrols:GridSplitter
				Grid.Column="3"
				MinWidth="1"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				Background="{ThemeResource DividerStrokeColorDefaultBrush}"
				Foreground="Transparent"
				IsTabStop="False"
				ResizeBehavior="PreviousAndNext"
				ResizeDirection="Columns" />

			<Grid Grid.Column="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
				<Grid.RowDefinitions>
					<RowDefinition Height="*" />
					<RowDefinition Height="Auto" />
					<RowDefinition Height="Auto" />
				</Grid.RowDefinitions>

				<ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
					<StackPanel Padding="20,20,20,20" Spacing="18">
						<StackPanel Spacing="20" Visibility="{x:Bind ViewModel.KeyOverviewVisibility, Mode=OneWay}">
							<Grid ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="44" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Viewbox
									Grid.Column="0"
									Width="36"
									Height="36">
									<Image Source="{x:Bind ViewModel.KeyOverviewIcon, Mode=OneWay}" />
								</Viewbox>
								<StackPanel Grid.Column="1" Spacing="4">
									<TextBlock
										Style="{StaticResource SubtitleTextBlockStyle}"
										Text="{x:Bind ViewModel.KeyOverviewName, Mode=OneWay}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap" />
									<TextBlock
										Foreground="{ThemeResource TextFillColorTertiaryBrush}"
										Text="{x:Bind ViewModel.KeyOverviewPath, Mode=OneWay}"
										TextTrimming="CharacterEllipsis"
										ToolTipService.ToolTip="{x:Bind ViewModel.KeyOverviewPath, Mode=OneWay}" />
								</StackPanel>
							</Grid>

							<Grid ColumnSpacing="8" RowSpacing="8">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="Auto" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Grid.RowDefinitions>
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
									<RowDefinition Height="Auto" />
								</Grid.RowDefinitions>
								<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Subkeys:" />
								<TextBlock Grid.Column="1" Text="{x:Bind ViewModel.KeyOverviewSubKeyCount, Mode=OneWay}" />
								<TextBlock
									Grid.Row="1"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="Values:" />
								<TextBlock
									Grid.Row="1"
									Grid.Column="1"
									Text="{x:Bind ViewModel.KeyOverviewValueCount, Mode=OneWay}" />
								<TextBlock
									Grid.Row="2"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="Last modified:" />
								<TextBlock
									Grid.Row="2"
									Grid.Column="1"
									Text="{x:Bind ViewModel.KeyOverviewModified, Mode=OneWay}"
									TextWrapping="Wrap" />
								<TextBlock
									Grid.Row="3"
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="Owner:" />
								<TextBlock
									Grid.Row="3"
									Grid.Column="1"
									Text="{x:Bind ViewModel.KeyOverviewOwner, Mode=OneWay}"
									TextWrapping="Wrap" />
							</Grid>
						</StackPanel>

						<StackPanel Spacing="18" Visibility="{x:Bind ViewModel.ValueEditorContentVisibility, Mode=OneWay}">
							<Grid ColumnSpacing="12">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="36" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Viewbox
									Grid.Column="0"
									Width="44"
									Height="44">
									<Image VerticalAlignment="Top" Source="{x:Bind ViewModel.ValueEditorIcon, Mode=OneWay}" />
								</Viewbox>
								<StackPanel Grid.Column="1" Spacing="4">
									<TextBlock
										Style="{StaticResource SubtitleTextBlockStyle}"
										Text="{x:Bind ViewModel.ValueEditorName, Mode=OneWay}"
										TextTrimming="CharacterEllipsis"
										TextWrapping="NoWrap" />
									<TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind ViewModel.ValueEditorType, Mode=OneWay}" />
								</StackPanel>
							</Grid>

							<StackPanel Spacing="12" Visibility="{x:Bind ViewModel.ValueEditorFieldsVisibility, Mode=OneWay}">
								<RadioButtons
									Header="Number format:"
									SelectedIndex="{x:Bind ViewModel.IntegerBaseIndex, Mode=TwoWay}"
									Visibility="{x:Bind ViewModel.IntegerBaseVisibility, Mode=OneWay}">
									<RadioButton Content="Hexadecimal (base 16)" />
									<RadioButton Content="Decimal (base 10)" />
									<RadioButton Content="Binary (base 2)" />
								</RadioButtons>

								<ItemsControl ItemsSource="{x:Bind ViewModel.IntegerBitBytes, Mode=OneWay}" Visibility="{x:Bind ViewModel.IntegerBitEditorVisibility, Mode=OneWay}">
									<ItemsControl.ItemsPanel>
										<ItemsPanelTemplate>
											<StackPanel Spacing="8" />
										</ItemsPanelTemplate>
									</ItemsControl.ItemsPanel>
									<ItemsControl.ItemTemplate>
										<DataTemplate x:DataType="viewModels:RegistryIntegerByteViewModel">
											<Grid ColumnSpacing="8">
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="36" />
													<ColumnDefinition Width="*" />
												</Grid.ColumnDefinitions>
												<TextBlock
													HorizontalAlignment="Right"
													VerticalAlignment="Center"
													FontSize="11"
													Foreground="{ThemeResource TextFillColorSecondaryBrush}"
													Text="{x:Bind RangeLabel}" />
												<ItemsControl Grid.Column="1" ItemsSource="{x:Bind Bits}">
													<ItemsControl.ItemsPanel>
														<ItemsPanelTemplate>
															<StackPanel Orientation="Horizontal" Spacing="4" />
														</ItemsPanelTemplate>
													</ItemsControl.ItemsPanel>
													<ItemsControl.ItemTemplate>
														<DataTemplate x:DataType="viewModels:RegistryIntegerBitViewModel">
															<ToggleButton
																Width="24"
																Height="28"
																Padding="0"
																AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
																Command="{x:Bind ToggleCommand}"
																Content="{x:Bind DisplayValue, Mode=OneWay}"
																IsChecked="{x:Bind IsSet, Mode=OneWay}"
																ToolTipService.ToolTip="{x:Bind AccessibleName, Mode=OneWay}" />
														</DataTemplate>
													</ItemsControl.ItemTemplate>
												</ItemsControl>
											</Grid>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>

								<TextBox
									x:Name="ValueEditorDataTextBox"
									MinHeight="132"
									MaxHeight="280"
									VerticalContentAlignment="Top"
									AcceptsReturn="{x:Bind ViewModel.ValueEditorAcceptsReturn, Mode=OneWay}"
									AutomationProperties.AutomationId="ValueEditorDataTextBox"
									FontFamily="{x:Bind ViewModel.ValueDataFontFamily, Mode=OneWay}"
									Header="{x:Bind ViewModel.ValueEditorDataHeader, Mode=OneWay}"
									PlaceholderText="{x:Bind ViewModel.ValueEditorDataPlaceholder, Mode=OneWay}"
									Text="{x:Bind ViewModel.ValueEditorData, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
									TextWrapping="Wrap"
									Visibility="{x:Bind ViewModel.ValueEditorDataTextBoxVisibility, Mode=OneWay}" />

								<TextBlock
									Foreground="{ThemeResource SystemFillColorCriticalBrush}"
									Text="{x:Bind ViewModel.ValueEditorError, Mode=OneWay}"
									TextWrapping="Wrap"
									Visibility="{x:Bind ViewModel.ValueEditorErrorVisibility, Mode=OneWay}" />

							</StackPanel>

							<Border
								Padding="12"
								Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
								BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
								BorderThickness="1"
								CornerRadius="8"
								Visibility="{x:Bind ViewModel.ValueEditorUnsupportedVisibility, Mode=OneWay}">
								<TextBlock
									Foreground="{ThemeResource TextFillColorSecondaryBrush}"
									Text="This value cannot be edited here. Its stored data is still shown in the list."
									TextWrapping="Wrap" />
							</Border>
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<Rectangle
					Grid.Row="1"
					Height="1"
					Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

				<Grid Grid.Row="2">
					<Grid Margin="20,16" Visibility="{x:Bind ViewModel.KeyOverviewActionsVisibility, Mode=OneWay}">
						<Button
							HorizontalAlignment="Right"
							Command="{x:Bind ViewModel.ExportCommand}"
							CommandParameter="{x:Bind ViewModel.SelectedNode, Mode=OneWay}"
							Content="Export..."
							IsEnabled="{x:Bind ViewModel.CanExportSelectedNode, Mode=OneWay}" />
					</Grid>

					<Grid
						Margin="20,16"
						ColumnSpacing="8"
						Visibility="{x:Bind ViewModel.ValueActionsVisibility, Mode=OneWay}">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<Button
							Grid.Column="1"
							Command="{x:Bind ViewModel.DiscardValueChangesCommand}"
							Content="Discard"
							IsEnabled="{x:Bind ViewModel.IsValueDirty, Mode=OneWay}" />
						<Button
							Grid.Column="3"
							Command="{x:Bind ViewModel.SaveValueChangesCommand}"
							Content="Save changes"
							IsEnabled="{x:Bind ViewModel.CanSaveValueChanges, Mode=OneWay}"
							Style="{StaticResource AccentButtonStyle}">
							<Button.KeyboardAccelerators>
								<KeyboardAccelerator Key="S" Modifiers="Control" />
							</Button.KeyboardAccelerators>
						</Button>
					</Grid>
				</Grid>
			</Grid>
		</Grid>
	</Grid>
</UserControl>
