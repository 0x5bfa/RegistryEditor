<ContentDialog
	x:Class="RegistryEditor.Views.CustomizeFontContentDialog"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:views="using:RegistryEditor.Views"
	Title="Customize font"
	CloseButtonText="Cancel"
	PrimaryButtonClick="CustomizeFontContentDialog_PrimaryButtonClick"
	PrimaryButtonText="Apply"
	Style="{StaticResource DefaultContentDialogStyle}">

	<ContentDialog.Resources>
		<DataTemplate x:Key="FontFamilySuggestionTemplate" x:DataType="views:FontFamilySuggestion">
			<TextBlock FontFamily="{x:Bind FontFamily}" Text="{x:Bind Name}" />
		</DataTemplate>
	</ContentDialog.Resources>

	<StackPanel MinWidth="360" Spacing="4">
		<AutoSuggestBox
			x:Name="AppFontFamilyAutoSuggestBox"
			AutomationProperties.AutomationId="AppFontFamilyAutoSuggestBox"
			Header="Application font:"
			ItemTemplate="{StaticResource FontFamilySuggestionTemplate}"
			PlaceholderText="Search installed fonts" />
		<TextBlock
			x:Name="AppFontErrorTextBlock"
			Foreground="{ThemeResource SystemFillColorCriticalBrush}"
			Text="Choose a font from the installed font list."
			TextWrapping="Wrap"
			Visibility="Collapsed" />
		<AutoSuggestBox
			x:Name="ValueDataFontFamilyAutoSuggestBox"
			Margin="0,12,0,0"
			AutomationProperties.AutomationId="ValueDataFontFamilyAutoSuggestBox"
			Header="Value data font:"
			ItemTemplate="{StaticResource FontFamilySuggestionTemplate}"
			PlaceholderText="Search installed fonts" />
		<TextBlock
			x:Name="ValueDataFontErrorTextBlock"
			Foreground="{ThemeResource SystemFillColorCriticalBrush}"
			Text="Choose a font from the installed font list."
			TextWrapping="Wrap"
			Visibility="Collapsed" />
	</StackPanel>
</ContentDialog>
