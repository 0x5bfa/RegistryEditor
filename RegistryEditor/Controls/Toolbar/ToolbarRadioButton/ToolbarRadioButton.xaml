<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:RegistryEditor.Controls">

	<Style BasedOn="{StaticResource DefaultToolbarRadioButtonStyle}" TargetType="local:ToolbarRadioButton" />

	<Style
		x:Key="DefaultToolbarRadioButtonStyle"
		BasedOn="{StaticResource DefaultRadioButtonStyle}"
		TargetType="local:ToolbarRadioButton">
		<Setter Property="MinWidth" Value="40" />
		<Setter Property="MinHeight" Value="32" />
	</Style>

</ResourceDictionary>
