<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:RegistryEditor.Controls">

	<Style BasedOn="{StaticResource DefaultToolbarFlyoutButtonStyle}" TargetType="local:ToolbarFlyoutButton" />

	<Style
		x:Key="DefaultToolbarFlyoutButtonStyle"
		BasedOn="{StaticResource DefaultToolbarButtonStyle}"
		TargetType="local:ToolbarFlyoutButton">
		<Setter Property="MinWidth" Value="40" />
		<Setter Property="MinHeight" Value="32" />
	</Style>

</ResourceDictionary>
