<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:local="using:RegistryEditor.Controls">

	<Style BasedOn="{StaticResource DefaultToolbarSplitButtonStyle}" TargetType="local:ToolbarSplitButton" />

	<Style
		x:Key="DefaultToolbarSplitButtonStyle"
		BasedOn="{StaticResource SplitButtonStyle}"
		TargetType="local:ToolbarSplitButton">
		<Setter Property="MinWidth" Value="40" />
		<Setter Property="MinHeight" Value="32" />
	</Style>

</ResourceDictionary>
