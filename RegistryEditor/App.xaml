<Application
	x:Class="RegistryEditor.App"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<Application.Resources>
		<ResourceDictionary>
			<FontFamily x:Key="RegistryAppFontFamily">Segoe UI Variable, Segoe UI, Arial</FontFamily>
			<FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable, Segoe UI, Arial</FontFamily>
			<FontFamily x:Key="RegistryValueDataFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

			<ResourceDictionary.MergedDictionaries>
				<XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />

				<ResourceDictionary Source="ms-appx:///Controls/BreadcrumbBar/BreadcrumbBar.xaml" />
				<ResourceDictionary Source="ms-appx:///Controls/Omnibar/Omnibar.xaml" />

			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Application.Resources>

</Application>
